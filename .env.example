# ── SAP connectivity ─────────────────────────────────────────────────────────
# mock  → seeded in-browser dataset, no SAP system needed (default)
# live  → real OData calls against an S/4HANA gateway
VITE_SAP_MODE=mock

# Base URL of the SAP gateway, e.g. https://my300001.s4hana.ondemand.com
# In dev, also export SAP_GATEWAY_URL with the same value so vite proxies
# /sap/opu/odata and the browser avoids CORS.
VITE_SAP_BASE_URL=

# Communication user for basic auth (S/4HANA Cloud communication arrangement
# SAP_COM_0308 / Enterprise Project). Leave empty to use SSO cookies instead.
VITE_SAP_USER=
VITE_SAP_PASSWORD=

# Optional: SAP client (on-prem systems), appended as sap-client=NNN
VITE_SAP_CLIENT=
